---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
}

const {
  title = 'THE EXPANSION',
  description = 'An exploration of technology, computing and ideas.',
  ogType = 'website'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111110" />

    <title>{title} | THE EXPANSION</title>

    <link
      rel="canonical"
      href={new URL(Astro.url.pathname, Astro.site).toString()}
    />

    <meta name="robots" content="index, follow" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="THE EXPANSION" />
    <meta property="og:title" content={`${title} | THE EXPANSION`} />
    <meta property="og:description" content={description} />
    <meta
      property="og:url"
      content={new URL(Astro.url.pathname, Astro.site).toString()}
    />

    <meta name="twitter:card" content="summary" />

    <meta
      name="google-site-verification"
      content="SMX3puj55xmTtAK85BnJEVyWLrRLZyAeenbFetRjiGw"
    />
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'THE EXPANSION',
  description = 'An exploration of technology, computing and ideas.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111110" />
    <title>{title} — THE EXPANSION</title>
    <meta name="google-site-verification" content="SMX3puj55xmTtAK85BnJEVyWLrRLZyAeenbFetRjiGw" />
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
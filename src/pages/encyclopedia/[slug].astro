---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { nodes, connections } from '../../components/KnowledgeUniverse.jsx';

export async function getStaticPaths() {
  const entries = await getCollection('encyclopedia');

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Related links come straight from the Knowledge Map so the two cannot drift.
const slug = entry.data.slug;
const connected = connections
  .filter(([a, b]) => a === slug || b === slug)
  .map(([a, b]) => nodes.find((node) => node.id === (a === slug ? b : a)))
  .filter(Boolean);
---

<MainLayout
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
>
  <article class="article container">
    <div class="eyebrow">{entry.data.category}</div>

    <h1 class="display-title">{entry.data.title}</h1>

    <p class="lead">{entry.data.description}</p>

    <div class="metadata">
      <span>CONCEPT</span>
      <span>{entry.data.category.toUpperCase()}</span>
      <span>KNOWLEDGE ENCYCLOPEDIA</span>
    </div>

    <div class="prose">
      <Content />
    </div>

    {connected.length > 0 && (
      <section class="connected">
        <h2>Connected on the Knowledge Map</h2>
        <div class="related">
          {connected.map((node) => (
            <a href={`/encyclopedia/${node.id}/`}>{node.name} ↗</a>
          ))}
        </div>
      </section>
    )}

    <nav class="article-nav" aria-label="Article navigation">
      <a href="/encyclopedia/">← Back to Encyclopedia</a>
      <a href="/knowledge-map/">Open the Knowledge Map ↗</a>
    </nav>
  </article>
</MainLayout>

<style>
  .article {
    max-width: 850px;
    padding-top: 90px;
    padding-bottom: 120px;
  }

  .article h1 {
    margin: 25px 0 10px;
    font-size: clamp(40px, 9vw, 84px);
    line-height: 1.05;
    overflow-wrap: break-word;
  }

  .lead {
    color: var(--muted);
    font-size: 18px;
    line-height: 1.7;
  }

  .metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin: 35px 0 65px;
    padding: 18px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-family: 'DM Mono', monospace;
    font-size: 9px;
  }

  /* :global is required: Markdown output does not carry Astro's scope attribute. */
  .prose {
    overflow-wrap: break-word;
  }

  .prose :global(h2),
  .connected h2 {
    margin: 55px 0 18px;
    font-family: 'Playfair Display', serif;
    font-size: 30px;
    font-weight: 500;
  }

  .prose :global(h3) {
    margin: 34px 0 12px;
    font-size: 18px;
    font-weight: 600;
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.9;
  }

  .prose :global(strong) {
    color: var(--text);
  }

  .prose :global(a) {
    color: var(--purple);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(pre) {
    overflow-x: auto;
    margin: 25px 0;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 13px;
    line-height: 1.7;
  }

  .prose :global(code) {
    font-family: 'DM Mono', Consolas, monospace;
  }

  .prose :global(:not(pre) > code) {
    padding: 2px 6px;
    border-radius: 5px;
    background: var(--surface-light);
    color: var(--lime);
    font-size: 0.88em;
    overflow-wrap: anywhere;
  }

  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    margin: 25px 0;
    border-collapse: collapse;
    font-size: 14px;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 12px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    color: var(--text);
    font-weight: 600;
  }

  .related {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .related a {
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 12px;
  }

  .related a:hover {
    border-color: var(--purple);
  }

  .article-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    margin-top: 60px;
    color: var(--lime);
    font-size: 12px;
  }

  @media (max-width: 760px) {
    .article {
      padding-top: 56px;
      padding-bottom: 80px;
    }

    .prose :global(pre) {
      padding: 16px;
      font-size: 12px;
    }
  }
</style>
